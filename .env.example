# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# From console.anthropic.com. Leave empty to run on rules only (no AI).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Comma-separated Telegram chat ids allowed to use /campaign and /stats.
# Send /myid to the bot to find yours.
ADMIN_CHAT_IDS=

DB_PATH=data/offers.db

# Optional: password for the marketing portal (streamlit run portal/app.py). Empty = no password.
PORTAL_PASSWORD=
